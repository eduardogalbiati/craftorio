{
  "name": "multiagent-orchestrator",
  "version": "0.3.0",
  "private": true,
  "description": "Multi-agent workflow orchestrator (Claude Code + Codex CLI) with observability.",
  "main": "src/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "docs": "node scripts/docs.js",
    "lint:lists": "node scripts/lint-lists.js",
    "prepare": "node scripts/docs.js --derived",
    "prestart": "node scripts/docs.js --derived",
    "start": "electron .",
    "run": "node scripts/run.js",
    "serve": "node scripts/serve.js",
    "pretest": "node scripts/docs.js --derived",
    "test": "node scripts/test.js",
    "screenshot": "electron scripts/screenshot.js",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:update": "bddgen && playwright test --update-snapshots",
    "test:engine": "node scripts/run.js --mock --auto-approve --task \"Engine test\"",
    "prebuild": "node scripts/docs.js --derived",
    "build": "node scripts/package.js build",
    "package": "node scripts/package.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "js-yaml": "^4.1.0",
    "marked": "^18.0.14",
    "node-pty": "^1.1.0",
    "nunjucks": "^3.2.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.5",
    "playwright-bdd": "^9.2.1"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
