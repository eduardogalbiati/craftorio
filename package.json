{
  "name": "multiagent-orchestrator",
  "version": "1.3.0",
  "private": true,
  "description": "Desktop app that runs multi-agent workflows defined in YAML, with Claude Code, Codex CLI and Grok Build as the agents, and records everything in a local workspace.",
  "license": "MIT",
  "author": "Eduardo Galbiati",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduardogalbiati/multiagent-orchestrator.git"
  },
  "homepage": "https://github.com/eduardogalbiati/multiagent-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/eduardogalbiati/multiagent-orchestrator/issues"
  },
  "main": "src/host/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check.js",
    "docs": "node scripts/docs.js",
    "lint:lists": "node scripts/lint-lists.js",
    "prepare": "node scripts/docs.js --derived && node scripts/build-3d.js",
    "prestart": "node scripts/docs.js --derived && node scripts/build-3d.js",
    "start": "electron .",
    "run": "node scripts/run.js",
    "serve": "node scripts/serve.js",
    "pretest": "node scripts/docs.js --derived",
    "test": "node scripts/test.js",
    "pretest:coverage": "node scripts/docs.js --derived",
    "test:coverage": "node scripts/test.js --experimental-test-coverage",
    "screenshot": "electron scripts/screenshot.js",
    "test:e2e": "bddgen && playwright test",
    "test:e2e:update": "bddgen && playwright test --update-snapshots",
    "test:engine": "node scripts/run.js --mock --auto-approve --task \"Engine test\"",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "prebuild": "node scripts/docs.js --derived && node scripts/build-3d.js",
    "build": "node scripts/package.js build",
    "build:3d": "node scripts/build-3d.js",
    "icons": "electron scripts/icons.js",
    "licenses": "node scripts/third-party-licenses.js",
    "package": "node scripts/package.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "acorn": "8.19.0",
    "dompurify": "^3.4.17",
    "js-yaml": "^4.1.0",
    "marked": "^18.0.14",
    "node-pty": "^1.1.0",
    "nunjucks": "^3.2.4",
    "qrcode-generator": "^1.5.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.63.0",
    "@react-three/fiber": "^8.18.0",
    "@types/node": "^24.19.2",
    "axe-core": "^4.14.0",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "playwright-bdd": "^9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
