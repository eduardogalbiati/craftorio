{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "target": "es2023",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "packages/*/**/*.js",
    "fronts/*/**/*.js",
    "apps/*/**/*.js"
  ],
  "exclude": [
    "**/node_modules/**",
    "packages/*/test/**",
    "fronts/*/test/**",
    "fronts/*/features/**",
    "apps/*/test/**"
  ]
}
